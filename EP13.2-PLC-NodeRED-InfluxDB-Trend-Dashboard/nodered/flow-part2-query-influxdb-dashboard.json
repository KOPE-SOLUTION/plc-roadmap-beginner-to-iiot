  {
    "id": "fn_format_chart",
    "type": "function",
    "z": "tab_ep132_p2",
    "name": "Format Chart Data",
    "func": "let rows = msg.payload || [];\n\nmsg.payload = rows.map(r => {\n  return {\n    x: new Date(r._time).getTime(),\n    y: Number(r._value)\n  };\n});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
