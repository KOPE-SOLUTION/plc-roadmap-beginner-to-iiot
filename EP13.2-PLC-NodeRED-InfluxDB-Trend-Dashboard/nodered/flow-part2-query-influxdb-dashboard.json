  {
    "id": "fn_flux_count",
    "type": "function",
    "z": "tab_ep132_p2",
    "name": "Flux Query - Count last 1h",
    "func": "msg.query = `from(bucket: \"plc_data\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"plc_status\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> aggregateWindow(every: 10s, fn: last, createEmpty: false)\n  |> yield(name: \"count\")`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 120,
    "wires": [
      [
        "influx_query_count"
      ]
    ]
  },
  {
    "id": "influx_query_count",
    "type": "influxdb in",
    "z": "tab_ep132_p2",
    "influxdb": "influx_config_placeholder",
    "name": "Query Count Trend",
    "query": "",
